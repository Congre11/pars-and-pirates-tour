# ---------------------------------------------------------------------------
# Pars & Pirates Tour — environment configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values.
#
# LEAVE EVERYTHING BLANK to run the app in DEMO MODE. In demo mode the whole
# app works (navigation, scoring engine, leaderboards, seeded tour data) using
# the browser's own storage. Scores sync between tabs on the same phone but
# NOT between different phones. Use it to look around before setting up
# Supabase.
#
# Fill these in to switch on real multi-device live scoring.
# ---------------------------------------------------------------------------

# From Supabase dashboard: Project Settings -> Data API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# From Supabase dashboard: Project Settings -> API Keys -> service_role.
# SECRET. Server-side only. Never commit a real value, never expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# The PIN everyone types to get into the tour. Anything you like.
TOUR_PIN=1927

# A second PIN that unlocks Admin (edit handicaps, pairings, courses, fix scores).
# Give this one to the captains/organiser only.
ADMIN_PIN=2609

# Random string used to sign the login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Optional: read scorecard photos ---------------------------------------
# Lets Admin photograph a course scorecard and have it read into editable
# fields to check before saving. Leave blank and you type the course data in
# by hand instead — every other part of the app works identically.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- Optional: Handicaps Network Africa (HNA) -------------------------------
# Leave blank unless HNA has given you official, authorised API access.
# With these blank the app uses manually entered handicap indexes, which is
# fully supported and loses no functionality.
HNA_API_BASE_URL=
HNA_API_KEY=
